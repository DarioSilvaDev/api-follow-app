  number        String         @unique @db.VarChar(30)
  vehicleId     String         @map("vehicle_id") @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  workOrderId   String?        @map("work_order_id") @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  status        EstimateStatus @default(draft)
  subtotal      Decimal        @db.Decimal(12, 2)
  taxRate       Decimal?       @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal?       @map("tax_amount") @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  validUntil    DateTime?      @map("valid_until") @db.Date
  notes         String?
  acceptedAt    DateTime?      @map("accepted_at") @db.Timestamptz(6)
  rejectedAt    DateTime?      @map("rejected_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  careEpisodeId String?        @map("care_episode_id") @db.Uuid
  items         EstimateItem[]
  branch        WorkshopBranch @relation(fields: [branchId], references: [id])
  careEpisode   CareEpisode?   @relation(fields: [careEpisodeId], references: [id], onDelete: Restrict)
  customer      User           @relation(fields: [customerId], references: [id])
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id])
  workshop      Workshop       @relation(fields: [workshopId], references: [id])

  @@index([number])
  @@index([vehicleId])
  @@index([workshopId])
  @@index([status])
  @@map("estimates")
}

model EstimateItem {
  id          String          @id @default(uuid()) @db.Uuid
  estimateId  String          @map("estimate_id") @db.Uuid
  type        ServiceItemType
  description String          @db.VarChar(500)
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  total       Decimal         @db.Decimal(12, 2)
  isTaxable   Boolean         @default(true) @map("is_taxable")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  estimate    Estimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@map("estimate_items")
}

