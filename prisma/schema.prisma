model WorkshopProfileChange {
  id              String   @id @default(uuid()) @db.Uuid
  workshopId      String   @map("workshop_id") @db.Uuid
  workshop        Workshop @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason          String?  @db.VarChar(200)
  fields          Json     @map("fields")

  @@index([workshopId, changedAt])
  @@index([changedByUserId])
  @@index([changedAt])
  @@map("workshop_profile_changes")
}
