# ─── Application ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hcdv_dev

# ─── JWT Authentication ────────────────────────────────────────────
# ACCESS tokens are short-lived (default 1500s ≈ 25min).
# REFRESH tokens are long-lived (default 7d) — used to obtain new access tokens.
JWT_SECRET=replace-with-a-secure-random-string
JWT_ACCESS_EXPIRES_IN=1500
JWT_REFRESH_SECRET=replace-with-a-different-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (API HTTP) ──────────────────────────────────────────────
# El envío va por API HTTPS, no por SMTP: los planes Free de Render bloquean
# el egreso SMTP saliente en los puertos 25, 465 y 587.
RESEND_API_KEY=re_replace-with-resend-api-key
# Remitente. Debe ser un dominio VERIFICADO en el panel del proveedor.
# `onboarding@resend.dev` solo entrega a la casilla del dueño de la cuenta:
# en producción falla en silencio para cualquier otro destinatario.
SMTP_FROM=noreply@example.com
# Tope de espera de la llamada HTTP. El SDK no impone ninguno y descarta el
# error original, así que sin este tope un request colgado retiene el listener
# indefinidamente sin dejar rastro.
MAIL_SEND_TIMEOUT_MS=15000
# Intentos totales de envío (1 = sin reintento). El reintento reenvía el MISMO
# token, el MISMO payload y la MISMA clave de idempotencia: el proveedor
# deduplica en vez de mandar un segundo email con el mismo enlace.
SMTP_RETRY_ATTEMPTS=3
SMTP_RETRY_BASE_DELAY_MS=2000

# ─── API ────────────────────────────────────────────────────────────
API_URL=http://localhost:3000

# Frontend official origin — used to build links inside sent emails
# (e.g. password reset: FRONTEND_URL/reset-password?token=...)
FRONTEND_URL=http://localhost:3000
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# ─── Throttler ─────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ─── Account Security ──────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ─── CORS ───────────────────────────────────────────────────────────
# IMPORTANT: with credentials:true (cookies HttpOnly, D-001) the browser
# rejects `*` — must be the real frontend origin (comma-separated list allowed).
CORS_ORIGIN=http://localhost:3000

# ─── Super Admin (optional — created on seed if present) ───────────
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASS=changeme

# ─── Storage: Cloudflare R2 ────────────────────────────────────────
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET=replace-with-bucket-name
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── Storage: Backblaze B2 ─────────────────────────────────────────
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.<region>.backblazeb2.com
B2_KEY_ID=replace-with-b2-key-id
B2_APP_KEY=replace-with-b2-app-key
B2_BUCKET=replace-with-bucket-name
B2_PUBLIC_URL=https://<bucket>.s3.<region>.backblazeb2.com

# ─── Signed URLs ───────────────────────────────────────────────────
SIGNED_URL_EXPIRES_SECONDS=3600
